# Copy to .env (gitignored) and adjust: cp .env.example .env

# Required. Not used until Day 2 (Postgres), but config fails fast without it.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/storedb?sslmode=disable

# Production (default) | Development | Staging. /alive is only mapped in Development.
APP_ENV=Development

# text (default) | json
LOG_FORMAT=text

# debug | info (default) | warn | error
LOG_LEVEL=info

# Optional. Defaults: store :5200, admin :5194. Setting it here applies to both binaries.
# HTTP_ADDR=:5200
